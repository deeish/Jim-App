# Copy to .env and fill in values. Never commit .env.

# Supabase Auth. From Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Supabase PostgreSQL. From Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Groq (free LLM for workout generation). From https://console.groq.com/ → API Keys
GROQ_API_KEY=
