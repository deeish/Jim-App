# Copy to .env and fill in values. Never commit .env.

# Optional: HTTP port (default 3000). Production: set NODE_ENV=production on the host/process manager.
# PORT=3000
# NODE_ENV=development

# Supabase Auth. From Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Supabase PostgreSQL. From Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=

# Groq (free LLM for workout generation). From https://console.groq.com/ → API Keys
GROQ_API_KEY=

# AI/Groq HTTP rate limits (per authenticated user; IP fallback if no user on path)
# Burst: max requests per rolling window. Day: max per 24h rolling window.
AI_RATE_BURST_MAX=12
AI_RATE_BURST_WINDOW_MS=60000
AI_RATE_DAY_MAX=120
AI_RATE_DAY_WINDOW_MS=86400000

# Public exercise catalog (/exercises). Per client IP by default (Nest ThrottlerGuard).
CATALOG_RATE_BURST_MAX=120
CATALOG_RATE_BURST_WINDOW_MS=60000
CATALOG_RATE_DAY_MAX=3000
CATALOG_RATE_DAY_WINDOW_MS=86400000

# Max JSON / urlencoded request body size (body-parser; e.g. 512kb, 1mb).
JSON_BODY_LIMIT=512kb

# Comma-separated browser origins allowed for CORS. Required when NODE_ENV=production.
# React Native often sends no Origin header and is still allowed.
# Dev: omit to use localhost defaults; production example: https://your-app.web.app,https://www.yourapp.com
CORS_ORIGINS=
