# Copy to .env and fill in values. Never commit .env.

# Optional: HTTP port (default 3000). Production: set NODE_ENV=production on the host/process manager.
# PORT=3000
# NODE_ENV=development

# Supabase Auth. From Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Expected JWT audience claim (Supabase issues "authenticated" for signed-in users). Override only
# if you've customised the Supabase auth audience.
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase PostgreSQL. From Supabase: Project Settings → Database → Connection string (URI)
# DATABASE_URL: transaction pooler (port 6543, pgbouncer=true) — used at runtime
# DIRECT_URL:   session-mode pooler (port 5432, no pgbouncer) — used by Prisma migrations only
DATABASE_URL=
DIRECT_URL=

# Plan generation model. Provider + model are config, not code (docs/llm-model-swap.md).
#   LLM_PROVIDER=gemini  → GEMINI_API_KEY, default model gemini-3.5-flash-lite
#   LLM_PROVIDER=groq    → GROQ_API_KEY,   default model openai/gpt-oss-120b
#     ⚠ NOT a dependable fallback: that account is the free tier Groq is withdrawing,
#     and 8k tokens/min is under what one plan spends. It passes a probe, not traffic.
# Neither key is required at boot: with no key for the selected provider every plan is
# rule-based and the server logs + Sentry say so (LlmModelWatch, once a day).
# Gemini key: Google AI Studio → API keys, inside project jim-app-508300, PAID tier only
# (the free tier trains on prompts; the privacy policy promises it does not).
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_MS=45000
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional (server only): Supabase → Project Settings → API → service_role secret.
# Deletes the Supabase Auth user when DELETE /api/users/me runs. Never expose to clients.
# If omitted, PostgreSQL rows are still removed but the Auth user may remain (delete in dashboard).
# SUPABASE_SERVICE_ROLE_KEY=

# AI/Groq HTTP rate limits (per authenticated user; IP fallback if no user on path)
# Burst: max requests per rolling window. Day: max per 24h rolling window.
AI_RATE_BURST_MAX=12
AI_RATE_BURST_WINDOW_MS=60000
AI_RATE_DAY_MAX=120
AI_RATE_DAY_WINDOW_MS=86400000

# Public exercise catalog (/exercises). Per client IP by default (Nest ThrottlerGuard).
CATALOG_RATE_BURST_MAX=120
CATALOG_RATE_BURST_WINDOW_MS=60000
CATALOG_RATE_DAY_MAX=3000
CATALOG_RATE_DAY_WINDOW_MS=86400000

# Optional: write each /plans/generate-sessions and /plans/generate-single-session
# request+response as JSON under backend/logs/generation-captures/ (for local QA).
# Each file includes: raw inputs, resolvedContext (equipment mapping, cardio modalities,
# experience, prior-id caps, enrichment equipment), per-chunk pipeline (session spec slice,
# hybrid/batch/per-session path, validators, groqCallsRaw with finish_reason, prior exercise ids),
# outputs.sessions + outputs.sessionsPreEnrichment (for enrichment diffs), meta.groq totals,
# meta.run (NODE_ENV + package version). Hybrid polish Groq usage is not appended to chunkGroqUsages
# (see groqCallsRaw length 0 on hybrid_ok unless batch paths add calls). Off by default.
# Do not enable in production unless you accept storing workout data on disk.
# GENERATION_CAPTURE=1
# Override output directory (absolute or relative to backend process cwd):
# GENERATION_CAPTURE_DIR=logs/generation-captures
#
# Console: every generate-sessions call also logs JSON to the Nest process stdout
# (`generate_sessions_request`, per-chunk `generate_sessions_chunk`, then
# `generate_sessions_summary`). Watch the terminal where `npm run start:dev` runs,
# not the React Native / browser devtools console.

# Max JSON / urlencoded request body size (body-parser; e.g. 512kb, 1mb).
JSON_BODY_LIMIT=512kb

# Comma-separated browser origins allowed for CORS. Required when NODE_ENV=production.
# React Native often sends no Origin header and is still allowed.
# Dev: omit to use localhost defaults; production example: https://your-app.web.app,https://www.yourapp.com
CORS_ORIGINS=

# Sentry (optional). Without SENTRY_DSN, the SDK is a no-op — safe to leave unset in dev.
# Server DSN from Sentry → Project → Settings → Client Keys (different project than the React Native app).
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV
# SENTRY_RELEASE=jim-api@1.0.0    # defaults to jim-api@<package version>
# SENTRY_TRACES_SAMPLE_RATE=0     # 0 = no performance traces (errors only). 0.1 = sample 10% of requests.
