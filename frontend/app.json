{
  "expo": {
    "name": "Jim",
    "slug": "jim-app",
    "owner": "deeish1",
    "scheme": "jimapp",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1b20c133-46eb-43d0-b4ca-d8f083fab3b0"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F2F7",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jimapp.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0047B3"
      },
      "package": "com.jimapp.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "1b20c133-46eb-43d0-b4ca-d8f083fab3b0"
      }
    }
  }
}
