{
  "expo": {
    "name": "Jim App",
    "slug": "jim-app",
    "owner": "deeish1",
    "scheme": "jimapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1110"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jimapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1110"
      },
      "package": "com.jimapp.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "1b20c133-46eb-43d0-b4ca-d8f083fab3b0"
      }
    }
  }
}
