# Copy to .env and fill in values. Never commit .env.
#
# Security: EXPO_PUBLIC_* vars are bundled into the client — anyone can read them.
# Only put public keys here (e.g. Supabase anon). Never put Groq/OpenAI, service_role, or DB secrets.

# Supabase Auth. From Supabase: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base (optional). Default is http://localhost:3000. For physical device: http://YOUR_IP:3000
# Production: https://api.yourdomain.com (no trailing slash; app adds /api)
EXPO_PUBLIC_API_BASE=

# Sentry (optional). Client DSN from Sentry → Projects → SDK setup. Without this, Sentry is disabled.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Override environment tag (defaults: development in __DEV__, else production).
# EXPO_PUBLIC_APP_ENV=preview
# Verbose Sentry logs in dev only: EXPO_PUBLIC_SENTRY_DEBUG=1
