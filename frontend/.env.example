# Copy to .env and fill in values. Never commit .env.
#
# Security: EXPO_PUBLIC_* vars are bundled into the client — anyone can read them.
# Only put public keys here (e.g. Supabase anon). Never put Groq/OpenAI, service_role, or DB secrets.

# Supabase Auth. From Supabase: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base (optional). Default is http://localhost:3000. For physical device: http://YOUR_IP:3000
# Production / Render: https://YOUR-SERVICE.onrender.com (no trailing slash; no /api; see docs/render-deploy.md)
EXPO_PUBLIC_API_BASE=

# Legal pages for in-app links and store listings. Must be https:// and publicly
# reachable. There is no fallback: unset (or an example.com placeholder) hides the
# row in Profile → About entirely. Set these in eas.json build profiles too —
# `eas update` bakes whatever .env the publishing machine has.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=

# Support inbox for the in-app "Feedback & support" mailto. Defaults to myjimplanner@gmail.com.
# EXPO_PUBLIC_FEEDBACK_EMAIL=

# Sentry (optional). Client DSN from Sentry → Projects → SDK setup. Without this, Sentry is disabled.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# Override environment tag (defaults: development in __DEV__, else production).
# EXPO_PUBLIC_APP_ENV=preview
# Verbose Sentry logs in dev only: EXPO_PUBLIC_SENTRY_DEBUG=1
#
# Password reset (Forgot password): In Supabase → Authentication → URL Configuration, add Redirect URLs
# that match your app scheme, e.g. jimapp://** (see app.json "scheme") and Expo dev URLs if needed.

# TestFlight distribution automation (local tooling only, never EXPO_PUBLIC).
# One-time: App Store Connect -> Users and Access -> Integrations -> Team Keys
# -> Generate API Key (role: App Manager). Download the .p8 (offered once),
# put it in frontend/ (gitignored via *.p8), and fill these in.
# Then: npm run tf:distribute -- --group "Friends" --wait
# ASC_API_KEY_ID=
# ASC_API_ISSUER_ID=
# ASC_API_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# App Store Connect app id (defaults to Jim's: 6776483293)
# ASC_APP_ID=
